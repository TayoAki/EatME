# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* values are built into the app; everything else stays on the server.

# ─── App ────────────────────────────────────────────────────────────────────────
# Quickest: the live Railway server — then the app needs nothing else from this file:
#   EXPO_PUBLIC_API_URL=https://api-production-174d.up.railway.app
# Leave it empty to use the API routes of your local Expo dev server (needs the server variables below).
# Release builds get it from eas.json.
EXPO_PUBLIC_API_URL=
# Where the Privacy Policy and Terms live (defaults to the Railway server, which hosts them).
EXPO_PUBLIC_LEGAL_URL=
# Optional: Sentry crash reporting. The app runs without it.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Server (API routes) ────────────────────────────────────────────────────────
# Railway Postgres. From your laptop use the public URL (Railway → Postgres → Connect →
# public network) and append ?sslmode=no-verify. On Railway itself: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Sign-in (Better Auth). Secret: a long random string, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The server's own URL: http://localhost:8081 locally, your Railway URL in production.
BETTER_AUTH_URL=http://localhost:8081
# Production only: accept sign-ins from Expo Go (exp://…) while testing. Turn off before release.
# ALLOW_EXPO_GO=true

# AI (OpenRouter). To call OpenAI directly instead, leave OPENROUTER_API_KEY empty and set OPENAI_API_KEY.
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
AI_VISION_MODEL=openai/gpt-5.6-luna
# OPENAI_API_KEY=
# Optional: another OpenAI-compatible endpoint (a local stand-in for tests, another provider).
# AI_BASE_URL=

# Meal photos: Railway storage bucket → Credentials tab.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Only for buckets created before Railway switched to virtual-hosted URLs:
# S3_PATH_STYLE=true

# Optional: email codes for "Forgot password?" and email verification (Resend, resend.com).
# Without both values the app hides these features. EMAIL_FROM must be on a domain verified in
# Resend, e.g. EatME <hello@yourdomain.com>.
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional: Sign in with Apple (iPhone) and Google. Each is off until its variables are set; the
# app only shows what the server has. Apple: the app's bundle ID (the ID token audience), plus the
# Sign in with Apple key so that deleting an account revokes Apple's tokens (App Store rule 5.1.1(v)).
# APPLE_BUNDLE_ID=com.tayoaki.eatme
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=        # contents of the .p8 file (newlines as 
)
# Google: a "Web application" OAuth client, redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: EatME Premium (off by default). App Store / Google Play subscriptions through RevenueCat.
# With payments on, free accounts get FREE_SCANS_PER_DAY AI scans a day (default 3).
# PAYMENTS_ENABLED=true
# FREE_SCANS_PER_DAY=3
# REVENUECAT_WEBHOOK_SECRET=     # RevenueCat → Integrations → Webhooks → Authorization header "Bearer <secret>"
# REVENUECAT_SECRET_KEY=         # secret API key (v1), for the sync right after a purchase
# The app's public SDK keys (built into the app):
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional: barcode lookups. Open Food Facts needs no key but asks apps to identify themselves
# ("AppName/Version (contact email)"). A free FoodData Central key (api.data.gov) adds USDA Branded
# Foods as a fallback for US products.
# OFF_USER_AGENT=EatME/1.0 (you@example.com)
# FDC_API_KEY=

# ─── Optional: readable Sentry stack traces in release builds ───────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=eatme
