# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* values are built into the app; everything else stays on the server.

# ─── App ────────────────────────────────────────────────────────────────────────
# Quickest: the live Railway server — then the app needs nothing else from this file:
#   EXPO_PUBLIC_API_URL=https://api-production-174d.up.railway.app
# Leave it empty to use the API routes of your local Expo dev server (needs the server variables below).
# Release builds get it from eas.json.
EXPO_PUBLIC_API_URL=
# Where the Privacy Policy and Terms live (defaults to the Railway server, which hosts them).
EXPO_PUBLIC_LEGAL_URL=
# Optional: Sentry crash reporting. The app runs without it.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Server (API routes) ────────────────────────────────────────────────────────
# Railway Postgres. From your laptop use the public URL (Railway → Postgres → Connect →
# public network) and append ?sslmode=no-verify. On Railway itself: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Sign-in (Better Auth). Secret: a long random string, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The server's own URL: http://localhost:8081 locally, your Railway URL in production.
BETTER_AUTH_URL=http://localhost:8081

# AI (OpenRouter). To call OpenAI directly instead, leave OPENROUTER_API_KEY empty and set OPENAI_API_KEY.
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
AI_VISION_MODEL=openai/gpt-5.6-luna
# OPENAI_API_KEY=

# Meal photos: Railway storage bucket → Credentials tab.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Only for buckets created before Railway switched to virtual-hosted URLs:
# S3_PATH_STYLE=true

# ─── Optional: readable Sentry stack traces in release builds ───────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=eatme
