# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Only EXPO_PUBLIC_* variables are bundled into the app — everything else stays on the server
# (Expo API routes + Trigger.dev tasks).

# ── App (public) ────────────────────────────────────────────────────────────
# Clerk dashboard → Configure → API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Sentry → Project settings → Client keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# Base URL of the deployed API routes (e.g. your EAS Hosting URL). Leave empty in development —
# the dev server serves the API routes.
EXPO_PUBLIC_API_URL=
# Deployed legal site (legal/ folder on Cloudflare) — used for the Privacy Policy / Terms links.
EXPO_PUBLIC_LEGAL_URL=https://eatme-legal.example.workers.dev

# ── Clerk (server) ──────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
# Clerk dashboard → Configure → Webhooks → your endpoint → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Neon Postgres ───────────────────────────────────────────────────────────
DATABASE_URL=

# ── Trigger.dev ─────────────────────────────────────────────────────────────
# Trigger.dev dashboard → API keys (dev key starts with tr_dev_)
TRIGGER_SECRET_KEY=
# Trigger.dev dashboard → Project settings → Project ref (proj_...)
TRIGGER_PROJECT_REF=

# ── AI (OpenRouter, OpenAI-compatible) ──────────────────────────────────────
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
AI_VISION_MODEL=openai/gpt-5.6-luna
# Optional: use OpenAI directly instead of OpenRouter (model ids without the "openai/" prefix)
# OPENAI_API_KEY=

# ── ImageKit ────────────────────────────────────────────────────────────────
# ImageKit dashboard → Developer options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Sentry source maps (EAS / local release builds) ─────────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=eatme
