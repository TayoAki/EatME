{
  "expo": {
    "name": "EatME",
    "slug": "eatme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eatme",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tayoaki.eatme",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.tayoaki.eatme",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "EatME uses the camera to scan your meals, nutrition labels and barcodes to estimate their calories and macros, and for the progress photos you choose to take. Progress photos stay private.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EatME opens your photos so you can analyze a meal or add a progress photo from your gallery. Progress photos stay private.",
          "cameraPermission": "EatME uses the camera to scan your meals and estimate their calories and macros, and for the progress photos you choose to take.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#111111"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/with-widget-privacy-manifest",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WaterWidget",
              "displayName": "Water",
              "description": "Today's water, with one tap to add a glass.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "EatME can read your steps, active energy, workouts and sleep to show them next to your meals, if you turn this on. They stay on your phone.",
          "NSHealthUpdateUsageDescription": "EatME saves the calories, protein, carbs, fat, fiber, water and drinks you log to Apple Health, if you turn this on.",
          "background": false
        }
      ],
      "./plugins/with-health-connect-rationale",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.tayoaki.eatme.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tayoaki.eatme"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "96841632-ec83-4462-a3da-a5de824148ce"
      }
    },
    "owner": "tayom"
  }
}
