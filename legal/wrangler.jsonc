// Cloudflare Workers (static assets only) config for the EatME landing page + legal pages.
// Preview: npx wrangler@4 dev --config legal/wrangler.jsonc   Deploy: npm run legal:deploy
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "eatme-legal",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Relative to this file: the legal/ folder itself (see .assetsignore for excluded files).
    "directory": "./",
    // /privacy serves privacy.html, /terms serves terms.html (and /privacy.html redirects to /privacy).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get 404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
