{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-production-174d.up.railway.app",
        "EXPO_PUBLIC_LEGAL_URL": "https://api-production-174d.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-production-174d.up.railway.app",
        "EXPO_PUBLIC_LEGAL_URL": "https://api-production-174d.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
